# TRUKVIA · Phase 4 · Gate 9f · Python-side Node routing settings (backend/.env).
# DEFAULTS ARE PRODUCTION-SAFE: with none of these set, nothing is forwarded.
# Node receives traffic only when ALL THREE are set: MODE=on, ROUTES non-empty,
# PERCENT > 0 — and never for a route outside backend-node/.migration-allowlist.

NODE_ROUTING_MODE=off               # off | on
NODE_ROUTING_ROUTES=                # comma list of FROZEN allowlist paths, e.g. /api/vendors,/api/vendors/:vid ; or "all"
NODE_ROUTING_PERCENT=0              # 0-100, stable per (session token, route)
NODE_UPSTREAM_URL=http://127.0.0.1:8002
NODE_ROUTING_CONNECT_TIMEOUT_S=0.5  # connect failure → Python fallback
NODE_ROUTING_READ_TIMEOUT_S=15      # read timeout → Python fallback (reads only, safe to replay)

# Kill switch: if this file exists, EVERYTHING is served by Python (checked every
# request, cached ≤ 1 s, no restart):   touch /app/backend/.node-routing-kill
NODE_ROUTING_KILL_FILE=/app/backend/.node-routing-kill

# Optional overrides (defaults resolve inside the repository checkout):
# NODE_ALLOWLIST_PATH=/app/backend-node/.migration-allowlist
# NODE_DEFERRED_PATH=/app/backend-node/.migration-deferred
