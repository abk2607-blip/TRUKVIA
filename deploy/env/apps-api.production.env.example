# TRUKVIA · Phase 4 · Gate 9h · production configuration for apps/api, the
# NestJS Finance writer. This is a DIFFERENT application from backend-node,
# which has its own file.
#
# Copy to /app/apps/api/.env on the platform (git-ignored). NO SECRETS HERE.
# Every value below is blank or a placeholder; the real ones are supplied by the
# platform and are never written into this repository, a commit message or a log.
#
# FORMAT (same finding as backend-node.production.env.example): run-apps-api.sh
# SOURCES this file with sh.
#   * DOUBLE-QUOTE every value — a Mongo URL with options contains `&`, and an
#     unquoted `&` splits the line (the wrapper then refuses to start).
#   * Save with LF line endings (a CRLF file leaves a trailing \r inside each value).
#
# run-apps-api.sh REQUIRES every uncommented name below. That is deliberate:
# each one has a local development default inside the application, and refusing
# to start is what stops such a default from being used in production.

NODE_ENV=production

# Secret — supplied by the platform.
NEST_MONGO_URL=""

# The database the writer will actually open.
NEST_MONGO_DB=

# Gate 9h §6 step 5b. Must equal NEST_MONGO_DB by EXACT whole-string comparison;
# in production the writer refuses to boot when it is absent or does not match.
# NOT YET PROVISIONED — step 5b has not been executed.
TRUKVIA_FIN_WRITER_ALLOWED_DB=

# Secret — supplied by the platform. The PostgreSQL read model. The Gate 9h
# surface (POST /internal/fin/reproject) does not query PostgreSQL, so this is
# not a Gate 9h dependency; the process reads it, so it is required here.
PG_URL=""

# Secret — supplied by the platform. At least 32 characters. Shared with the
# Python process: it is the `x-internal-token` on POST /internal/fin/reproject,
# compared in constant time. Never logged.
TRUKVIA_INTERNAL_TOKEN=""

# Loopback only — the Python process is the sole client. The application binds
# 127.0.0.1 in src/main.ts; this sets the port on that interface, and it must
# match the port in Python's TRUKVIA_FIN_NODE_URL.
PORT=8003

# ── Optional ────────────────────────────────────────────────────────────────
# The forward hook back to Python is a safety net, not a routine path: all
# thirteen supported source types have a TypeScript projection, so the
# Python-delegating branch is not reached in normal operation. Leave both unset
# unless that safety net is deliberately wanted.
# TRUKVIA_FIN_HOOK_URL=""
# TRUKVIA_FIN_HOOK_TIMEOUT_MS=
