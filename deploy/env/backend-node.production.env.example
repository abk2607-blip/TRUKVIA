# TRUKVIA · Phase 4 · Gate 9f · production configuration for backend-node.
# Copy to /app/backend-node/.env on the platform (git-ignored). NO SECRETS HERE.
# Every value is read by src/config.ts; missing/invalid values stop the process.
#
# FORMAT (Gate 9g rehearsal finding F1): run-backend-node.sh SOURCES this file with sh.
#   * DOUBLE-QUOTE every value — a Mongo URL with options contains `&`, and an
#     unquoted `&` splits the line (the wrapper then refuses to start):
#       NODE_MONGO_URL="mongodb://user:pass@host:27017/db?authSource=db&appName=trukvia-node"
#   * Save with LF line endings (a CRLF file leaves a trailing \r inside each value).

NODE_ENV=production
NODE_LOG_LEVEL=info                 # never debug/trace in production (no payload logging)
NODE_HOST=127.0.0.1                 # loopback only: the Python router is the only client
NODE_PORT=8002                      # must equal the port in Python's NODE_UPSTREAM_URL

# Secret — supplied by the platform. Use a READ-ONLY database user (see runbook §8):
# Node performs no business writes; a read-only role makes that a database guarantee.
# Gate 9g rehearsed strategy 1: role { role: "read", db: "<NODE_DB_NAME>" } only, with the
# idempotency_keys TTL index already present (Python creates it at startup).
NODE_MONGO_URL=""
NODE_DB_NAME=                       # the SAME database Python uses (backend/.env DB_NAME)

# Must be the same value as Python's CORS_ORIGINS (backend/.env). Empty = "*",
# exactly like Python's fallback. A mismatch changes CORS headers on routed requests.
NODE_CORS_ORIGINS=

NODE_REQUEST_ID_HEADER=x-request-id
# true is safe ONLY because Node is loopback-bound and the Python router always
# replaces any client X-Request-Id with its own before forwarding.
NODE_TRUST_INCOMING_REQUEST_ID=true
