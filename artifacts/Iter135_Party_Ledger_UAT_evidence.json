{
  "iteration": "Iter135",
  "task": "Vendor / Mechanic Ledger — Vehicle Context + Unified Accounting Presentation + PDF",
  "verdict": "COMPLETE — READY FOR UAT",
  "architecture": {
    "single_authoritative_source": "backend/services_party_ledger.py :: build_party_ledger()",
    "consumers": [
      "GET /api/vendors/{vid}/ledger        (JSON, screen)",
      "GET /api/vendors/{vid}/ledger.pdf   (PDF, print)",
      "GET /api/mechanics/{mid}/ledger      (JSON, screen)",
      "GET /api/mechanics/{mid}/ledger.pdf (PDF, print)"
    ],
    "reconciliation_guarantee": "Screen and PDF consume the SAME LedgerDataset object. Neither the frontend nor the PDF renderer performs balance math."
  },
  "accounting_semantics": {
    "opening_balance": "party.opening_balance ± sum(debit − credit) of pre-window bills/WOs and payments (include_reversed=false excludes reversed payments everywhere)",
    "in_window": "bill_date / work_date / payment date within [from, to]",
    "closing_balance": "opening + total_debit − total_credit",
    "ordering": "date → kind priority (opening=0, bill/WO=1, payment=2) → created_at → id"
  },
  "vehicle_derivation": {
    "bill_or_wo_row": "snapshot on the record (denormalised at write time)",
    "payment_row": "single batched lookup on vendor_bills / mechanic_work_orders keyed on vendor_bill_id / mechanic_work_order_id",
    "unallocated_payment": "vehicle_id='' and vehicle_number='' — UI renders '— Unallocated'",
    "zero_schema_change": true,
    "no_vehicle_id_added_to_payment_models": true
  },
  "pdf": {
    "renderer": "backend/pdf/party_ledger.py (ReportLab A4 portrait, two-pass NumberedCanvas)",
    "columns": "Date | Type | Ref | Vehicle | Description | Debit | Credit | Balance",
    "repeated_table_header": true,
    "page_of_y_footer": true,
    "size_guardrail": "MAX_PDF_ENTRIES=5000 → HTTP 413 with 'Narrow the date range' (no silent truncation)"
  },
  "test_run": {
    "test_iter135_party_ledger.py": "14 / 14 PASS",
    "cases": [
      "test_vendor_ledger_bill_vehicle_appears_and_closing_math",
      "test_vendor_unallocated_payment_has_no_vehicle",
      "test_vendor_opening_folds_pre_window_movements",
      "test_mechanic_ledger_wo_vehicle_appears_and_closing_zero",
      "test_mechanic_unallocated_payment_has_no_vehicle",
      "test_vendor_vehicle_filter_reconciles",
      "test_vendor_pdf_totals_reconcile_with_json",
      "test_mechanic_pdf_totals_reconcile_with_json",
      "test_empty_ledger_renders_pdf_ok",
      "test_multipage_pdf_headers_and_page_of_y",
      "test_ledger_never_reads_expenses_collection",
      "test_ledger_router_never_reads_expenses_collection",
      "test_correction_reversal_vehicle_context_continuity",
      "test_pdf_guardrail_no_silent_truncation",
      "test_vehicle_lookup_is_single_query",
      "test_batched_vehicle_lookup_code_shape"
    ]
  },
  "live_uat": {
